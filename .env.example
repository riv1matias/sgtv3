# Base de datos PostgreSQL
DATABASE_URL=postgres://postgres@localhost:5432/sgt

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres)
SESSION_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-000000

# Autenticación: "dev" (selector de usuarios de prueba) u "oidc" (IdP corporativo IDIRA)
AUTH_MODE=dev
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# Almacenamiento de archivos: "local" (carpeta ./storage) o "s3"
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
